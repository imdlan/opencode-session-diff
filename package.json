{
  "name": "opencode-session-diff",
  "version": "0.1.0",
  "description": "OpenCode sidebar panel listing the current session's file changes (±line counts)",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "sidebar",
    "diff",
    "session"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun && bun build ./src/tui.tsx --outdir ./dist --target bun --external @opencode/plugin --external '@opencode/plugin/*' --external @opencode/client --external '@opencode/*' --external '@opentui/*' --external solid-js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.32",
    "@opencode/theme": "2.0.32",
    "@opentui/solid": "latest",
    "@types/bun": "^1.4.3",
    "solid-js": "latest",
    "typescript": "^5"
  },
  "homepage": "https://github.com/imdlan/opencode-session-diff",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imdlan/opencode-session-diff.git"
  },
  "bugs": {
    "url": "https://github.com/imdlan/opencode-session-diff/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
